{
  "uid": "budzet-overview",
  "title": "Budzet Overview",
  "description": "개발 환경 백엔드의 지표 수집 상태와 JVM·HTTP 지표",
  "tags": [
    "budzet",
    "development"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "수집 상태",
      "description": "UP: 최근 수집 성공 / DOWN: 최근 수집 실패. 업무 API 전체의 정상 동작을 보장하지 않습니다. No data는 수집 기록이 없음을 뜻합니다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "budzet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "budzet-prometheus"
          },
          "expr": "up{job=\"budzet\"}",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "JVM 힙 메모리",
      "description": "JVM에서 사용 중인 힙 메모리 합계입니다. 프로세스 전체 메모리와는 다릅니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "budzet-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "budzet-prometheus"
          },
          "expr": "sum(jvm_memory_used_bytes{job=\"budzet\",area=\"heap\"})",
          "legendFormat": "Heap used",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "title": "JVM 스레드",
      "description": "현재 살아 있는 JVM 스레드 수입니다. 내부 작업 스레드도 포함합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "budzet-prometheus"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "budzet-prometheus"
          },
          "expr": "jvm_threads_live_threads{job=\"budzet\"}",
          "legendFormat": "Live threads",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP 초당 요청 수",
      "description": "경로·메서드별 초당 요청 수입니다. Actuator 호출은 제외합니다. 최초 요청과 수집 샘플이 쌓인 뒤 표시됩니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "budzet-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "budzet-prometheus"
          },
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"budzet\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{method}} {{uri}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP 평균 응답 시간",
      "description": "경로·메서드별 최근 구간의 평균 처리 시간(ms)입니다. 요청이 없는 구간은 비워 둡니다. Actuator 호출은 제외합니다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "budzet-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "budzet-prometheus"
          },
          "expr": "(sum by (method, uri) (rate(http_server_requests_seconds_sum{job=\"budzet\",uri!~\"/actuator.*\"}[$__rate_interval])) / (sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"budzet\",uri!~\"/actuator.*\"}[$__rate_interval])) > 0)) * 1000",
          "legendFormat": "{{method}} {{uri}}",
          "range": true,
          "instant": false
        }
      ]
    }
  ]
}
